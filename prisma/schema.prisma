generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  // Second full-access "super" role, identical to ADMIN everywhere in the
  // app (see isFullAccessRole in lib/roles.ts) -- exists purely as a
  // separate label for organizations that use both titles.
  SUPERVISOR
  STAFF
  MINISTRY_REGISTRAR
  MINISTRY_OFFICER
  VENDOR
  LOGISTICS_STAFF
}

enum ShipmentType {
  IMPORT
  EXPORT
  TRANSSHIPMENT
  DOMESTIC
  CUSTOMS_CLEARANCE
}

// Physical mode of transport, independent of ShipmentType (an IMPORT can
// travel by sea or air; a DOMESTIC move is by road) -- determines which
// of the mode-specific fields below apply.
enum TransportMode {
  SEA
  AIR
  ROAD
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  ARRIVED
  CUSTOMS_HOLD
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PAID
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerSourceType {
  INVOICE_REVENUE
  INVOICE_PAYMENT
  EXPENSE_ACCRUAL
  EXPENSE_PAYOUT
  MANUAL
  INVOICE_REVERSAL
  EXPENSE_REVERSAL
  ADVANCE_RECEIPT
  ADVANCE_REFUND
  SUPPLIER_PAYMENT
  TRANSFER
}

enum MoneyAccountKind {
  CASH
  BANK
  MOBILE_MONEY
}

// DEPOSIT: money a client paid up front. OVERPAYMENT: the excess of a
// payment over an invoice's balance, kept as client credit.
enum AdvanceSource {
  DEPOSIT
  OVERPAYMENT
}

enum SupplierBillStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CARD
  MOBILE_MONEY
  OTHER
  // Settled from the client's advance / credit balance, not new money.
  ADVANCE
}

enum ClientStage {
  PROSPECT
  ACTIVE
  DORMANT
  LOST
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AgreementType {
  SERVICE_AGREEMENT
  FREIGHT_FORWARDING
  NON_DISCLOSED
  RATE_AGREEMENT
  CUSTOMS_BROKERAGE
  WAREHOUSING
  AGENCY
  OPEN_ACCOUNT
  CLOSED
}

enum ServiceType {
  CUSTOMS_CLEARANCE
  IMPORT
  EXPORT
  IMMIGRATION_SUPPORT
  EXPEDITION
  TRANSPORTATION
  TOPUPS
  EMPLOYMENT_PAYMENT
}

enum ApprovalStepStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  REQUEST_CORRECTION
}

// Clearance status is a separate axis from Shipment.status (which tracks
// physical/operational shipment progress). This tracks the ministry
// approval chain specifically, and only applies once a chain is started.
enum ClearanceStatus {
  NOT_STARTED
  IN_REVIEW
  AWAITING_VENDOR_CORRECTION
  CLEARED_FOR_DELIVERY
  REJECTED
}

enum DeliveryMode {
  AIRPORT
  SEAPORT
}

// Terminal state for this module. `status` is left on the record as the
// integration seam for a future delivery/shipping module to update
// (e.g. IN_TRANSIT, DELIVERED) without this module needing to change.
enum DeliveryRecordStatus {
  PENDING
  COMPLETED
}

enum NotificationType {
  CORRECTION_REQUESTED
  MINISTRY_ACTION_TAKEN
  SHIPMENT_CLEARED
  FOLLOW_UP_DUE
  DOCUMENT_EXPIRING
  TASK_OVERDUE
  JOB_OVERDUE
}

// A submission to a ministry / government office / immigration office.
enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  INFO_REQUIRED
  APPROVED
  REJECTED
  WITHDRAWN
}

// ---------------------------------------------------------------------------
// Service operations backbone:
// Client -> Service Request -> Job/Case -> Stages/Tasks/Documents -> Costs
// -> Invoice -> Payment -> Profit
// ---------------------------------------------------------------------------

enum ClientType {
  CORPORATE
  NGO
  INTERNATIONAL_ORGANIZATION
  GOVERNMENT_RELATED
  INDIVIDUAL
  OTHER
}

// Top-level service families. Individual services live in the
// ServiceDefinition table so new ones can be added without a migration.
enum ServiceCategory {
  LOGISTICS
  TRANSPORT
  GOVERNMENT_TAX
  VEHICLE
  IMMIGRATION
  COMMUNICATION
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ServiceRequestStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  QUOTED
  APPROVED
  IN_PROGRESS
  WAITING
  COMPLETED
  CLOSED
  CANCELLED
}

enum JobStatus {
  OPEN
  IN_PROGRESS
  WAITING
  COMPLETED
  CLOSED
  CANCELLED
}

enum JobStageStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

// How an operational cost relates to what the client is charged.
enum ExpenseBillingType {
  // Company's own cost (office power, overheads) -- never re-charged.
  NON_BILLABLE
  // Paid on the client's behalf and re-charged at cost (e.g. a government
  // fee) -- a recoverable disbursement, not company revenue or expense.
  BILLABLE
  // Re-charged at cost plus a handling/service markup; the cost is a
  // recoverable disbursement and the markup is company revenue.
  BILLABLE_WITH_MARKUP
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  // Deactivating (rather than deleting) revokes login while preserving
  // every record they've authored/approved -- a hard delete is only
  // possible when the account has no linked activity at all (see
  // deleteUserAction), since most of those relations restrict deletion.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shipments Shipment[] @relation("ShipmentAssignee")

  clientNotes             ClientNote[]
  purchaseRequests        PurchaseRequest[] @relation("PurchaseRequestRequestedBy")
  decidedPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestDecidedBy")

  // MINISTRY_REGISTRAR / MINISTRY_OFFICER users are scoped to one ministry.
  ministry   Ministry? @relation(fields: [ministryId], references: [id])
  ministryId String?

  // VENDOR users are scoped to one Client (the vendor/customer company
  // submitting shipments for clearance).
  vendorClient   Client? @relation(fields: [vendorClientId], references: [id])
  vendorClientId String?

  uploadedDocuments        ClearanceDocument[]
  uploadedDocumentVersions ClearanceDocumentVersion[]
  approvalActions          ApprovalAction[]
  deliveryRecords          DeliveryRecord[]
  notifications            Notification[]

  approvedExpenses   Expense[]           @relation("ExpenseApprover")
  ledgerTransactions LedgerTransaction[]

  assignedServiceRequests ServiceRequest[] @relation("ServiceRequestAssignee")
  createdServiceRequests  ServiceRequest[] @relation("ServiceRequestCreatedBy")
  responsibleJobs         Job[]            @relation("JobResponsible")
  completedJobStages      JobStage[]       @relation("JobStageCompletedBy")
  assignedTasks           JobTask[]        @relation("JobTaskAssignee")
  receivedJobDocuments    JobDocument[]    @relation("JobDocumentReceivedBy")
  auditLogs               AuditLog[]
  officerSubmissions      JobSubmission[]  @relation("SubmissionOfficer")
  createdSubmissions      JobSubmission[]  @relation("SubmissionCreatedBy")
  jobFollowUps            JobFollowUp[]

  @@map("users")
}

model Client {
  id            String         @id @default(cuid())
  name          String
  // Immutable 5-character uppercase code derived from the name at
  // creation (see lib/client-mnemonic.ts), e.g. "Atlas Trading Co." ->
  // "ATLAS". A short, memorable reference distinct from the client's id.
  mnemonic      String         @unique
  email         String?
  phone         String?
  address       String?
  notes         String?
  stage         ClientStage    @default(ACTIVE)
  agreementType AgreementType?
  services      ServiceType[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  clientType       ClientType @default(CORPORATE)
  contactPerson    String?
  department       String?
  country          String?
  taxNumber        String?
  // Days from invoice issue to due date (e.g. 30 = net 30).
  paymentTermsDays Int?
  currency         String     @default("USD")
  creditLimit      Decimal?   @db.Decimal(12, 2)

  serviceRequests ServiceRequest[]
  jobs            Job[]
  expenses        Expense[]
  advances        ClientAdvance[]

  shipments        Shipment[]
  invoices         Invoice[]
  quotes           Quote[]
  purchaseRequests PurchaseRequest[]
  serviceRates     ClientServiceRate[]

  clientNotes ClientNote[]
  followUps   ClientFollowUp[]

  // VENDOR-role users representing this company in the ministry clearance module.
  vendorUsers User[]

  @@map("clients")
}

model ClientServiceRate {
  id            String      @id @default(cuid())
  serviceType   ServiceType
  markupPercent Decimal     @db.Decimal(5, 2)

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@unique([clientId, serviceType])
  @@map("client_service_rates")
}

model ClientNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  @@map("client_notes")
}

model ClientFollowUp {
  id        String   @id @default(cuid())
  dueDate   DateTime
  note      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@map("client_follow_ups")
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  service   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses         Expense[]
  purchaseRequests PurchaseRequest[]
  supplierBills    SupplierBill[]

  @@map("vendors")
}

model Shipment {
  id               String         @id @default(cuid())
  reference        String         @unique
  type             ShipmentType
  status           ShipmentStatus @default(PENDING)
  transportMode    TransportMode  @default(SEA)
  origin           String
  destination      String
  cargoDescription String?
  etd              DateTime?
  eta              DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  // SEA
  vessel          String?
  containerNumber String?
  billOfLading    String?

  // AIR
  airwayBill    String?
  flightCarrier String?

  // ROAD (domestic)
  vehicleType String?

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  assignee   User?   @relation("ShipmentAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  invoices         Invoice[]
  expenses         Expense[]
  quotes           Quote[]
  purchaseRequests PurchaseRequest[]
  jobs             Job[]

  // Ministry document approval & delivery clearance
  clearanceStatus    ClearanceStatus     @default(NOT_STARTED)
  clearanceDocuments ClearanceDocument[]
  approvalSteps      ApprovalStep[]
  deliveryRecord     DeliveryRecord?

  @@map("shipments")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Guards against posting the Dr AR / Cr Revenue ledger entry more than
  // once for the same invoice (set the first time it reaches SENT).
  revenueRecognizedAt DateTime?

  // Invoice-level discount (an amount, taken off the service fees) and tax
  // rate (%, applied to service fees after discount -- costs re-charged at
  // cost are disbursements and are not taxed).
  discountAmount    Decimal   @default(0) @db.Decimal(12, 2)
  taxRate           Decimal   @default(0) @db.Decimal(5, 2)
  cancelledAt       DateTime?
  cancelReason      String?
  // Set when a cancelled invoice's revenue entry has been reversed.
  revenueReversedAt DateTime?

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  quote   Quote?  @relation(fields: [quoteId], references: [id])
  quoteId String? @unique

  items              InvoiceItem[]
  payments           Payment[]
  ledgerTransactions LedgerTransaction[]
  overpaymentCredits ClientAdvance[]     @relation("AdvanceFromInvoice")

  // Speeds up "this client's open/unbilled invoices" lookups as the table
  // grows, instead of a sequential scan filtered by status in app code.
  @@index([clientId, status])
  @@map("invoices")
}

model InvoiceItem {
  id          String       @id @default(cuid())
  description String
  quantity    Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  serviceType ServiceType?

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  // Every line should trace back to the Job/Case it bills for.
  job   Job?    @relation(fields: [jobId], references: [id])
  jobId String?

  // Set when this line re-charges a billable cost at cost; the ledger then
  // credits Client Disbursements Recoverable instead of revenue for it.
  sourceExpense   Expense? @relation("InvoiceItemSourceExpense", fields: [sourceExpenseId], references: [id])
  sourceExpenseId String?  @unique

  @@index([jobId])
  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  // Where the money landed (cash box, bank account, mobile money wallet).
  moneyAccount   MoneyAccount? @relation(fields: [moneyAccountId], references: [id])
  moneyAccountId String?

  // Set when this payment applies a client advance / credit instead of new money.
  advance   ClientAdvance? @relation(fields: [advanceId], references: [id])
  advanceId String?

  ledgerTransaction LedgerTransaction?

  @@index([advanceId])
  @@map("payments")
}

model ExpenseCategory {
  id   String @id @default(cuid())
  name String @unique

  // Lazily created the first time an expense in this category is accrued,
  // so each cost category (fuel, carrier fees, customs duties, ...) posts
  // to its own EXPENSE account in the chart of accounts.
  account   Account? @relation(fields: [accountId], references: [id])
  accountId String?  @unique

  expenses         Expense[]
  purchaseRequests PurchaseRequest[]

  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(cuid())
  description String
  amount      Decimal       @db.Decimal(12, 2)
  status      ExpenseStatus @default(PENDING)
  incurredAt  DateTime      @default(now())
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Managerial approval, required before payout for amounts over the
  // $500 auto-pay threshold (see lib/expense-approval.ts).
  approvedBy     User?     @relation("ExpenseApprover", fields: [approvedById], references: [id])
  approvedById   String?
  approvedAt     DateTime?
  rejectedReason String?

  // Guard timestamps so the accrual / payout ledger entries are each
  // posted at most once per expense.
  accrualPostedAt DateTime?
  payoutPostedAt  DateTime?

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  // Cost attribution: which Job/Case and client this cost belongs to, and
  // whether (and how) it is re-charged to the client. Locked once accrued,
  // since it decides which ledger account the cost posts to.
  job          Job?               @relation(fields: [jobId], references: [id])
  jobId        String?
  client       Client?            @relation(fields: [clientId], references: [id])
  clientId     String?
  billingType  ExpenseBillingType @default(NON_BILLABLE)
  markupAmount Decimal            @default(0) @db.Decimal(12, 2)

  // EXP-YYYY-NNNNN (expenses recorded before numbering was introduced have none).
  expenseNumber     String?        @unique
  paymentMethod     PaymentMethod?
  paidFrom          MoneyAccount?  @relation(fields: [paidFromId], references: [id])
  paidFromId        String?
  receiptUrl        String?
  receiptName       String?
  // A line on a supplier's bill: paid through the bill, not individually.
  supplierBill      SupplierBill?  @relation(fields: [supplierBillId], references: [id])
  supplierBillId    String?
  // Set when a rejected expense's accrual has been reversed out of the ledger.
  accrualReversedAt DateTime?

  purchaseRequest    PurchaseRequest?
  ledgerTransactions LedgerTransaction[]
  invoiceItem        InvoiceItem?        @relation("InvoiceItemSourceExpense")

  @@index([jobId])
  @@index([supplierBillId])
  @@map("expenses")
}

// Chart of accounts. The system accounts (Cash, Accounts Receivable,
// Accounts Payable, Freight Revenue) are bootstrapped idempotently by
// lib/ledger.ts on first use; one EXPENSE account per ExpenseCategory is
// created the same way.
model Account {
  id        String      @id @default(cuid())
  code      String      @unique
  name      String
  type      AccountType
  isSystem  Boolean     @default(false)
  createdAt DateTime    @default(now())

  ledgerLines     LedgerLine[]
  expenseCategory ExpenseCategory?
  moneyAccount    MoneyAccount?

  @@map("accounts")
}

// One immutable journal entry per financial event (invoice revenue
// recognition, cash receipt, expense accrual, expense payout). Its lines
// always sum to zero -- enforced in lib/ledger.ts's postTransaction, never
// left to the UI to get right.
model LedgerTransaction {
  id              String           @id @default(cuid())
  memo            String
  sourceType      LedgerSourceType
  transactionDate DateTime         @default(now())
  createdAt       DateTime         @default(now())

  createdBy   User?   @relation(fields: [createdById], references: [id])
  createdById String?

  invoice   Invoice? @relation(fields: [invoiceId], references: [id])
  invoiceId String?

  // A payment is posted to the ledger at most once, at creation time.
  payment   Payment? @relation(fields: [paymentId], references: [id])
  paymentId String?  @unique

  expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?

  advance   ClientAdvance? @relation(fields: [advanceId], references: [id])
  advanceId String?

  refund   AdvanceRefund? @relation(fields: [refundId], references: [id])
  refundId String?        @unique

  supplierPayment   SupplierPayment? @relation(fields: [supplierPaymentId], references: [id])
  supplierPaymentId String?          @unique

  transfer   MoneyTransfer? @relation(fields: [transferId], references: [id])
  transferId String?        @unique

  lines LedgerLine[]

  @@index([transactionDate])
  @@map("ledger_transactions")
}

model LedgerLine {
  id        String          @id @default(cuid())
  direction LedgerDirection
  amount    Decimal         @db.Decimal(12, 2)

  account   Account @relation(fields: [accountId], references: [id])
  accountId String

  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String

  // Backs the account_balances view's per-account aggregation and the
  // zero-variance trigger's per-transaction lookup -- without these, both
  // degrade to a sequential scan of the whole table as it grows.
  @@index([accountId])
  @@index([transactionId])
  @@map("ledger_lines")
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  requestNumber String                @unique
  description   String
  amount        Decimal               @db.Decimal(12, 2)
  status        PurchaseRequestStatus @default(PENDING)
  serviceType   ServiceType?
  notes         String?
  requestedAt   DateTime              @default(now())
  decidedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  requestedBy   User   @relation("PurchaseRequestRequestedBy", fields: [requestedById], references: [id])
  requestedById String

  decidedBy   User?   @relation("PurchaseRequestDecidedBy", fields: [decidedById], references: [id])
  decidedById String?

  expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?  @unique

  quoteItem QuoteItem?

  // Speeds up "this client's approved-but-unquoted purchase requests"
  // lookups as the table grows (the New Quote cascade picker).
  @@index([clientId, status])
  @@map("purchase_requests")
}

model Quote {
  id          String       @id @default(cuid())
  quoteNumber String       @unique
  status      QuoteStatus  @default(DRAFT)
  // What kind of job this will become once accepted -- set here, at
  // quote time, since the Shipment itself doesn't exist yet. Copied onto
  // the Shipment unchanged when "Start shipment" creates it.
  type        ShipmentType @default(IMPORT)
  issueDate   DateTime     @default(now())
  expiryDate  DateTime?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  items          QuoteItem[]
  invoice        Invoice?
  serviceRequest ServiceRequest?

  // Speeds up "this client's in-process quotes" lookups as the table
  // grows (e.g. the New Invoice cascade picker).
  @@index([clientId, status])
  @@map("quotes")
}

model QuoteItem {
  id          String       @id @default(cuid())
  description String
  quantity    Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  serviceType ServiceType?

  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  purchaseRequestId String?          @unique

  @@map("quote_items")
}

// ---------------------------------------------------------------------------
// Vendor -> Ministry Document Approval & Delivery Clearance
// ---------------------------------------------------------------------------

model Ministry {
  id                    String   @id @default(cuid())
  name                  String
  code                  String   @unique
  description           String?
  active                Boolean  @default(true)
  defaultPosition       Int?
  requiredDocumentTypes String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users         User[]
  chainSteps    MinistryChainStep[]
  approvalSteps ApprovalStep[]

  @@map("ministries")
}

// The authoritative, configurable ordering of ministries per shipment type.
// Ministry.defaultPosition is only a suggested starting point when building
// a new chain in the admin UI.
model MinistryChainStep {
  id           String       @id @default(cuid())
  shipmentType ShipmentType
  position     Int

  ministry   Ministry @relation(fields: [ministryId], references: [id])
  ministryId String

  createdAt DateTime @default(now())

  @@unique([shipmentType, ministryId])
  @@unique([shipmentType, position])
  @@map("ministry_chain_steps")
}

model ClearanceDocument {
  id           String   @id @default(cuid())
  documentType String
  createdAt    DateTime @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  versions ClearanceDocumentVersion[]

  @@map("clearance_documents")
}

// Corrections create new versions; existing versions are never overwritten
// or deleted, preserving what each ministry actually reviewed.
model ClearanceDocumentVersion {
  id        String   @id @default(cuid())
  version   Int
  fileUrl   String
  fileName  String
  createdAt DateTime @default(now())

  document   ClearanceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  approvalActions ApprovalAction[]

  @@unique([documentId, version])
  @@map("clearance_document_versions")
}

// One row per (shipment, ministry). Only one step per shipment is ever
// PENDING/IN_REVIEW at a time -- the chain is strictly sequential.
model ApprovalStep {
  id        String             @id @default(cuid())
  position  Int
  status    ApprovalStepStatus @default(PENDING)
  startedAt DateTime?
  decidedAt DateTime?
  createdAt DateTime           @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId String

  ministry   Ministry @relation(fields: [ministryId], references: [id])
  ministryId String

  actions ApprovalAction[]

  @@unique([shipmentId, ministryId])
  @@map("approval_steps")
}

// Append-only audit log. No update/delete action is exposed anywhere in the
// app for this model -- it is the permanent record of who did what, when.
model ApprovalAction {
  id        String             @id @default(cuid())
  action    ApprovalActionType
  note      String
  createdAt DateTime           @default(now())

  step   ApprovalStep @relation(fields: [stepId], references: [id])
  stepId String

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  documentVersion   ClearanceDocumentVersion? @relation(fields: [documentVersionId], references: [id])
  documentVersionId String?

  @@map("approval_actions")
}

// Terminal state for this module. `status` and the shipment relation are
// the integration seam for a future delivery/shipping module.
model DeliveryRecord {
  id                String               @id @default(cuid())
  deliveryMode      DeliveryMode
  destinationDetail String
  status            DeliveryRecordStatus @default(PENDING)
  createdAt         DateTime             @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId String   @unique

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@map("delivery_records")
}

// Lightweight in-app notification (this platform has no email/queue
// infrastructure yet -- see conversation note on Celery substitution).
model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  message    String
  shipmentId String?
  jobId      String?
  // Set on automatic reminders so the same reminder is never sent twice
  // (e.g. "FU:<submissionId>:2026-10-06", "EXP:<documentId>:7").
  dedupeKey  String?          @unique
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("notifications")
}

// Configurable service catalog. Each service carries its own workflow
// template (stages, document checklist, tasks, service-specific fields),
// copied onto every Job created for it -- so admins can add or adjust
// services without any schema change, and editing a template never
// rewrites the history of jobs already in progress.
model ServiceDefinition {
  id          String          @id @default(cuid())
  code        String          @unique
  name        String
  category    ServiceCategory
  // Job numbers are JOB-{jobPrefix}-{year}-{seq}, e.g. JOB-TAX-2026-0002.
  jobPrefix   String
  description String?
  // Expected turnaround in days (0 = same day); drives Job.dueDate.
  slaDays     Int?
  active      Boolean         @default(true)
  sortOrder   Int             @default(0)

  // [{ name, requiresDocuments? }] -- requiresDocuments blocks completing
  // that stage until every required (non-output) document is received.
  stages              Json    @default("[]")
  // [{ name, required, isOutput? }] -- isOutput marks the official output
  // (certificate, final document, POD...) a job can't be completed without.
  documents           Json    @default("[]")
  // [{ title, dueOffsetDays? }]
  tasks               Json    @default("[]")
  // [{ key, label, type: "text"|"number"|"date"|"select"|"textarea", options? }]
  fields              Json    @default("[]")
  // Bulk services (e.g. 100 SIM registrations): requested must equal
  // processed + failed before the job can be completed.
  reconcileQuantities Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs         Job[]
  requestLines ServiceRequestLine[]

  @@map("service_definitions")
}

model ServiceRequest {
  id                 String               @id @default(cuid())
  requestNumber      String               @unique
  status             ServiceRequestStatus @default(SUBMITTED)
  priority           Priority             @default(NORMAL)
  requestedByName    String?
  department         String?
  requestDate        DateTime             @default(now())
  requiredBy         DateTime?
  description        String
  location           String?
  assignedDepartment String?
  estimatedRevenue   Decimal?             @db.Decimal(12, 2)
  estimatedCost      Decimal?             @db.Decimal(12, 2)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  assignedTo   User?   @relation("ServiceRequestAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  createdBy   User?   @relation("ServiceRequestCreatedBy", fields: [createdById], references: [id])
  createdById String?

  // Set when the request came from an accepted quotation.
  quote   Quote?  @relation(fields: [quoteId], references: [id])
  quoteId String? @unique

  lines ServiceRequestLine[]
  jobs  Job[]

  @@index([clientId, status])
  @@map("service_requests")
}

// One requested service within a Service Request; each becomes a Job.
model ServiceRequestLine {
  id    String  @id @default(cuid())
  notes String?

  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  serviceRequestId String

  service   ServiceDefinition @relation(fields: [serviceId], references: [id])
  serviceId String

  job Job?

  @@map("service_request_lines")
}

// The central Job/Case: every operational activity, whatever the service,
// gets one -- it is the link between operations and finance.
model Job {
  id               String    @id @default(cuid())
  jobNumber        String    @unique
  title            String
  description      String?
  status           JobStatus @default(OPEN)
  priority         Priority  @default(NORMAL)
  startDate        DateTime  @default(now())
  dueDate          DateTime?
  completedAt      DateTime?
  closedAt         DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  // Service-specific field values, keyed by the service's field keys.
  details          Json      @default("{}")
  estimatedRevenue Decimal?  @db.Decimal(12, 2)
  estimatedCost    Decimal?  @db.Decimal(12, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  service   ServiceDefinition @relation(fields: [serviceId], references: [id])
  serviceId String

  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  serviceRequestId String?

  requestLine   ServiceRequestLine? @relation(fields: [requestLineId], references: [id])
  requestLineId String?             @unique

  responsible   User?   @relation("JobResponsible", fields: [responsibleId], references: [id])
  responsibleId String?

  // Logistics jobs can be linked to the detailed shipment record.
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  stages       JobStage[]
  tasks        JobTask[]
  documents    JobDocument[]
  submissions  JobSubmission[]
  expenses     Expense[]
  invoiceItems InvoiceItem[]
  advances     ClientAdvance[]

  @@index([clientId, status])
  @@index([serviceId, status])
  @@index([status, dueDate])
  @@map("jobs")
}

model JobStage {
  id                String         @id @default(cuid())
  position          Int
  name              String
  requiresDocuments Boolean        @default(false)
  status            JobStageStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  note              String?

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  completedBy   User?   @relation("JobStageCompletedBy", fields: [completedById], references: [id])
  completedById String?

  @@unique([jobId, position])
  @@map("job_stages")
}

model JobTask {
  id          String     @id @default(cuid())
  title       String
  status      TaskStatus @default(TODO)
  priority    Priority   @default(NORMAL)
  dueDate     DateTime?
  notes       String?
  completedAt DateTime?
  createdAt   DateTime   @default(now())

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  assignee   User?   @relation("JobTaskAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  @@index([assigneeId, status])
  @@map("job_tasks")
}

// Document checklist item. Received documents may carry an uploaded file,
// or be recorded as received on paper.
model JobDocument {
  id           String    @id @default(cuid())
  name         String
  required     Boolean   @default(true)
  isOutput     Boolean   @default(false)
  received     Boolean   @default(false)
  receivedAt   DateTime?
  fileUrl      String?
  fileName     String?
  reference    String?
  expiryDate   DateTime?
  note         String?
  // A manager can waive a document with a recorded reason -- e.g. no
  // certificate is issued because the ministry rejected the application.
  waived       Boolean   @default(false)
  waivedReason String?

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  receivedBy   User?   @relation("JobDocumentReceivedBy", fields: [receivedById], references: [id])
  receivedById String?

  @@map("job_documents")
}

// Append-only audit trail. A database trigger forbids UPDATE and DELETE,
// so the record holds regardless of which code path touches it.
model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  action     String
  module     String
  entityType String
  entityId   String?
  // Human-readable reference, e.g. "JOB-TAX-2026-0002".
  reference  String?
  message    String
  before     Json?
  after      Json?

  actor     User?   @relation(fields: [actorId], references: [id], onDelete: Restrict)
  actorId   String?
  actorName String?

  jobId String?

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([jobId])
  @@map("audit_logs")
}

// Atomic per-key counters for document numbers whose key varies at runtime
// (e.g. one counter per job prefix per year: "JOB-TAX-2026").
model DocumentCounter {
  key   String @id
  value BigInt @default(0)

  @@map("document_counters")
}

// Government agency directory (ministries, departments, immigration and
// tax offices) that case submissions are made to.
model GovernmentAgency {
  id                    String   @id @default(cuid())
  name                  String
  department            String?
  office                String?
  contactName           String?
  contactPhone          String?
  contactEmail          String?
  location              String?
  // Services handled there, e.g. "Tax exemption certificates".
  services              String?
  referenceRequirements String?
  notes                 String?
  // Default days until the first / next follow-up after a submission.
  followUpDays          Int      @default(7)
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  submissions JobSubmission[]

  @@map("government_agencies")
}

// One submission of a case to an agency. Every follow-up is recorded
// against it, and an open submission always carries its next follow-up date.
model JobSubmission {
  id                 String           @id @default(cuid())
  reference          String?
  submittedAt        DateTime
  documentsSubmitted String[]
  status             SubmissionStatus @default(SUBMITTED)
  response           String?
  respondedAt        DateTime?
  nextAction         String?
  nextFollowUpAt     DateTime?
  notes              String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  job   Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId String

  agency   GovernmentAgency @relation(fields: [agencyId], references: [id])
  agencyId String

  // Staff member responsible for this submission at the agency.
  officer   User?   @relation("SubmissionOfficer", fields: [officerId], references: [id])
  officerId String?

  createdBy   User?   @relation("SubmissionCreatedBy", fields: [createdById], references: [id])
  createdById String?

  followUps JobFollowUp[]

  @@index([jobId])
  @@index([status, nextFollowUpAt])
  @@map("job_submissions")
}

model JobFollowUp {
  id             String    @id @default(cuid())
  followedUpAt   DateTime
  contact        String?
  outcome        String
  nextAction     String?
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())

  submission   JobSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  submissionId String

  by   User?   @relation(fields: [byId], references: [id])
  byId String?

  @@map("job_follow_ups")
}

// ---------------------------------------------------------------------------
// Phase 3: money accounts, client advances, supplier bills
// ---------------------------------------------------------------------------

// A cash box, bank account or mobile money wallet. Each one is backed by
// its own ASSET account in the chart of accounts, so every receipt and
// payment says where the money actually is.
model MoneyAccount {
  id            String           @id @default(cuid())
  name          String           @unique
  kind          MoneyAccountKind @default(BANK)
  bankName      String?
  accountNumber String?
  currency      String           @default("USD")
  isDefault     Boolean          @default(false)
  active        Boolean          @default(true)
  notes         String?
  createdAt     DateTime         @default(now())

  account   Account @relation(fields: [accountId], references: [id])
  accountId String  @unique

  payments         Payment[]
  advances         ClientAdvance[]
  refunds          AdvanceRefund[]
  supplierPayments SupplierPayment[]
  expensesPaid     Expense[]
  transfersOut     MoneyTransfer[]   @relation("TransferFrom")
  transfersIn      MoneyTransfer[]   @relation("TransferTo")

  @@map("money_accounts")
}

// Moving money between the company's own accounts (e.g. banking cash).
model MoneyTransfer {
  id            String   @id @default(cuid())
  amount        Decimal  @db.Decimal(12, 2)
  transferredAt DateTime
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())

  from   MoneyAccount @relation("TransferFrom", fields: [fromId], references: [id])
  fromId String
  to     MoneyAccount @relation("TransferTo", fields: [toId], references: [id])
  toId   String

  ledgerTransaction LedgerTransaction?

  @@map("money_transfers")
}

// Money a client paid before being invoiced (or paid in excess of an
// invoice). A liability -- the company owes the services or the money
// back -- until applied to an invoice or refunded; never revenue.
model ClientAdvance {
  id            String        @id @default(cuid())
  advanceNumber String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  receivedAt    DateTime
  method        PaymentMethod @default(BANK_TRANSFER)
  reference     String?
  notes         String?
  source        AdvanceSource @default(DEPOSIT)
  createdAt     DateTime      @default(now())

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  // Optionally earmarked for a job (e.g. a deposit for a tax exemption case).
  job   Job?    @relation(fields: [jobId], references: [id])
  jobId String?

  moneyAccount   MoneyAccount? @relation(fields: [moneyAccountId], references: [id])
  moneyAccountId String?

  // For OVERPAYMENT credits: the invoice that was overpaid.
  sourceInvoice   Invoice? @relation("AdvanceFromInvoice", fields: [sourceInvoiceId], references: [id])
  sourceInvoiceId String?

  applications       Payment[]
  refunds            AdvanceRefund[]
  ledgerTransactions LedgerTransaction[]

  @@index([clientId])
  @@map("client_advances")
}

model AdvanceRefund {
  id         String        @id @default(cuid())
  amount     Decimal       @db.Decimal(12, 2)
  refundedAt DateTime
  method     PaymentMethod @default(BANK_TRANSFER)
  reference  String?
  reason     String
  createdAt  DateTime      @default(now())

  advance   ClientAdvance @relation(fields: [advanceId], references: [id])
  advanceId String

  moneyAccount   MoneyAccount? @relation(fields: [moneyAccountId], references: [id])
  moneyAccountId String?

  ledgerTransaction LedgerTransaction?

  @@map("advance_refunds")
}

// A supplier's invoice to us. Its lines are expenses (each attributed to
// a job / category / billing type as usual), accrued to Accounts Payable
// when the bill is entered and settled by supplier payments.
model SupplierBill {
  id                String             @id @default(cuid())
  billNumber        String             @unique
  supplierReference String?
  billDate          DateTime
  dueDate           DateTime
  status            SupplierBillStatus @default(OPEN)
  notes             String?
  attachmentUrl     String?
  attachmentName    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  vendor   Vendor @relation(fields: [vendorId], references: [id])
  vendorId String

  lines    Expense[]
  payments SupplierPayment[]

  @@index([vendorId, status])
  @@map("supplier_bills")
}

model SupplierPayment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(12, 2)
  paidAt    DateTime
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  createdAt DateTime      @default(now())

  bill   SupplierBill @relation(fields: [billId], references: [id])
  billId String

  moneyAccount   MoneyAccount? @relation(fields: [moneyAccountId], references: [id])
  moneyAccountId String?

  ledgerTransaction LedgerTransaction?

  @@map("supplier_payments")
}
