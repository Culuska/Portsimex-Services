generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum ShipmentType {
  IMPORT
  EXPORT
  TRANSSHIPMENT
  DOMESTIC
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  ARRIVED
  CUSTOMS_HOLD
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CARD
  MOBILE_MONEY
  OTHER
}

enum ClientStage {
  PROSPECT
  ACTIVE
  DORMANT
  LOST
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AgreementType {
  CLOSED
  NON_DISCLOSED
}

enum ServiceType {
  CUSTOMS_CLEARANCE
  IMPORT
  EXPORT
  IMMIGRATION_SUPPORT
  EXPEDITION
  TRANSPORTATION
  TOPUPS
  EMPLOYMENT_PAYMENT
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shipments Shipment[] @relation("ShipmentAssignee")

  clientNotes             ClientNote[]
  purchaseRequests        PurchaseRequest[] @relation("PurchaseRequestRequestedBy")
  decidedPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestDecidedBy")

  @@map("users")
}

model Client {
  id            String      @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  notes         String?
  stage         ClientStage    @default(ACTIVE)
  markupPercent Decimal        @default(0) @db.Decimal(5, 2)
  agreementType AgreementType?
  services      ServiceType[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shipments        Shipment[]
  invoices         Invoice[]
  quotes           Quote[]
  purchaseRequests PurchaseRequest[]

  clientNotes ClientNote[]
  followUps   ClientFollowUp[]

  @@map("clients")
}

model ClientNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  @@map("client_notes")
}

model ClientFollowUp {
  id        String   @id @default(cuid())
  dueDate   DateTime
  note      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@map("client_follow_ups")
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  service   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses         Expense[]
  purchaseRequests PurchaseRequest[]

  @@map("vendors")
}

model Shipment {
  id               String         @id @default(cuid())
  reference        String         @unique
  type             ShipmentType
  status           ShipmentStatus @default(PENDING)
  origin           String
  destination      String
  cargoDescription String?
  containerNumber  String?
  vessel           String?
  etd              DateTime?
  eta              DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  assignee   User?   @relation("ShipmentAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  invoices         Invoice[]
  expenses         Expense[]
  quotes           Quote[]
  purchaseRequests PurchaseRequest[]

  @@map("shipments")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  quote   Quote?  @relation(fields: [quoteId], references: [id])
  quoteId String? @unique

  items    InvoiceItem[]
  payments Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String       @id @default(cuid())
  description String
  quantity    Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  serviceType ServiceType?

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  @@map("payments")
}

model ExpenseCategory {
  id   String @id @default(cuid())
  name String @unique

  expenses         Expense[]
  purchaseRequests PurchaseRequest[]

  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(cuid())
  description String
  amount      Decimal       @db.Decimal(12, 2)
  status      ExpenseStatus @default(PENDING)
  incurredAt  DateTime      @default(now())
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  purchaseRequest PurchaseRequest?

  @@map("expenses")
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  requestNumber String                @unique
  description   String
  amount        Decimal               @db.Decimal(12, 2)
  status        PurchaseRequestStatus @default(PENDING)
  serviceType   ServiceType?
  notes         String?
  requestedAt   DateTime              @default(now())
  decidedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  requestedBy   User   @relation("PurchaseRequestRequestedBy", fields: [requestedById], references: [id])
  requestedById String

  decidedBy   User?   @relation("PurchaseRequestDecidedBy", fields: [decidedById], references: [id])
  decidedById String?

  expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?  @unique

  quoteItem QuoteItem?

  @@map("purchase_requests")
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)
  issueDate   DateTime    @default(now())
  expiryDate  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  items   QuoteItem[]
  invoice Invoice?

  @@map("quotes")
}

model QuoteItem {
  id          String       @id @default(cuid())
  description String
  quantity    Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  serviceType ServiceType?

  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  purchaseRequestId String?          @unique

  @@map("quote_items")
}
