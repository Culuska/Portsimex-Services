generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
  MINISTRY_REGISTRAR
  MINISTRY_OFFICER
  VENDOR
  LOGISTICS_STAFF
}

enum ShipmentType {
  IMPORT
  EXPORT
  TRANSSHIPMENT
  DOMESTIC
}

enum ShipmentStatus {
  PENDING
  IN_TRANSIT
  ARRIVED
  CUSTOMS_HOLD
  COMPLETED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum ExpenseStatus {
  PENDING
  PAID
}

enum PaymentMethod {
  BANK_TRANSFER
  CASH
  CHECK
  CARD
  MOBILE_MONEY
  OTHER
}

enum ClientStage {
  PROSPECT
  ACTIVE
  DORMANT
  LOST
}

enum PurchaseRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AgreementType {
  SERVICE_AGREEMENT
  FREIGHT_FORWARDING
  NON_DISCLOSED
  RATE_AGREEMENT
  CUSTOMS_BROKERAGE
  WAREHOUSING
  AGENCY
  OPEN_ACCOUNT
  CLOSED
}

enum ServiceType {
  CUSTOMS_CLEARANCE
  IMPORT
  EXPORT
  IMMIGRATION_SUPPORT
  EXPEDITION
  TRANSPORTATION
  TOPUPS
  EMPLOYMENT_PAYMENT
}

enum ApprovalStepStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CORRECTION_REQUESTED
}

enum ApprovalActionType {
  APPROVE
  REJECT
  REQUEST_CORRECTION
}

// Clearance status is a separate axis from Shipment.status (which tracks
// physical/operational shipment progress). This tracks the ministry
// approval chain specifically, and only applies once a chain is started.
enum ClearanceStatus {
  NOT_STARTED
  IN_REVIEW
  AWAITING_VENDOR_CORRECTION
  CLEARED_FOR_DELIVERY
  REJECTED
}

enum DeliveryMode {
  AIRPORT
  SEAPORT
}

// Terminal state for this module. `status` is left on the record as the
// integration seam for a future delivery/shipping module to update
// (e.g. IN_TRANSIT, DELIVERED) without this module needing to change.
enum DeliveryRecordStatus {
  PENDING
  COMPLETED
}

enum NotificationType {
  CORRECTION_REQUESTED
  MINISTRY_ACTION_TAKEN
  SHIPMENT_CLEARED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(STAFF)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  shipments Shipment[] @relation("ShipmentAssignee")

  clientNotes             ClientNote[]
  purchaseRequests        PurchaseRequest[] @relation("PurchaseRequestRequestedBy")
  decidedPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestDecidedBy")

  // MINISTRY_REGISTRAR / MINISTRY_OFFICER users are scoped to one ministry.
  ministry   Ministry? @relation(fields: [ministryId], references: [id])
  ministryId String?

  // VENDOR users are scoped to one Client (the vendor/customer company
  // submitting shipments for clearance).
  vendorClient   Client? @relation(fields: [vendorClientId], references: [id])
  vendorClientId String?

  uploadedDocuments        ClearanceDocument[]
  uploadedDocumentVersions ClearanceDocumentVersion[]
  approvalActions          ApprovalAction[]
  deliveryRecords          DeliveryRecord[]
  notifications            Notification[]

  @@map("users")
}

model Client {
  id            String         @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  notes         String?
  stage         ClientStage    @default(ACTIVE)
  agreementType AgreementType?
  services      ServiceType[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  shipments        Shipment[]
  invoices         Invoice[]
  quotes           Quote[]
  purchaseRequests PurchaseRequest[]
  serviceRates     ClientServiceRate[]

  clientNotes ClientNote[]
  followUps   ClientFollowUp[]

  // VENDOR-role users representing this company in the ministry clearance module.
  vendorUsers User[]

  @@map("clients")
}

model ClientServiceRate {
  id            String      @id @default(cuid())
  serviceType   ServiceType
  markupPercent Decimal     @db.Decimal(5, 2)

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@unique([clientId, serviceType])
  @@map("client_service_rates")
}

model ClientNote {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  author   User?   @relation(fields: [authorId], references: [id])
  authorId String?

  @@map("client_notes")
}

model ClientFollowUp {
  id        String   @id @default(cuid())
  dueDate   DateTime
  note      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@map("client_follow_ups")
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  service   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses         Expense[]
  purchaseRequests PurchaseRequest[]

  @@map("vendors")
}

model Shipment {
  id               String         @id @default(cuid())
  reference        String         @unique
  type             ShipmentType
  status           ShipmentStatus @default(PENDING)
  origin           String
  destination      String
  cargoDescription String?
  containerNumber  String?
  vessel           String?
  etd              DateTime?
  eta              DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  assignee   User?   @relation("ShipmentAssignee", fields: [assigneeId], references: [id])
  assigneeId String?

  invoices         Invoice[]
  expenses         Expense[]
  quotes           Quote[]
  purchaseRequests PurchaseRequest[]

  // Ministry document approval & delivery clearance
  clearanceStatus    ClearanceStatus     @default(NOT_STARTED)
  clearanceDocuments ClearanceDocument[]
  approvalSteps      ApprovalStep[]
  deliveryRecord     DeliveryRecord?

  @@map("shipments")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String        @unique
  status        InvoiceStatus @default(DRAFT)
  issueDate     DateTime      @default(now())
  dueDate       DateTime
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  quote   Quote?  @relation(fields: [quoteId], references: [id])
  quoteId String? @unique

  items    InvoiceItem[]
  payments Payment[]

  @@map("invoices")
}

model InvoiceItem {
  id          String       @id @default(cuid())
  description String
  quantity    Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  serviceType ServiceType?

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  @@map("invoice_items")
}

model Payment {
  id        String        @id @default(cuid())
  amount    Decimal       @db.Decimal(12, 2)
  method    PaymentMethod @default(BANK_TRANSFER)
  reference String?
  paidAt    DateTime      @default(now())
  createdAt DateTime      @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId String

  @@map("payments")
}

model ExpenseCategory {
  id   String @id @default(cuid())
  name String @unique

  expenses         Expense[]
  purchaseRequests PurchaseRequest[]

  @@map("expense_categories")
}

model Expense {
  id          String        @id @default(cuid())
  description String
  amount      Decimal       @db.Decimal(12, 2)
  status      ExpenseStatus @default(PENDING)
  incurredAt  DateTime      @default(now())
  paidAt      DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  purchaseRequest PurchaseRequest?

  @@map("expenses")
}

model PurchaseRequest {
  id            String                @id @default(cuid())
  requestNumber String                @unique
  description   String
  amount        Decimal               @db.Decimal(12, 2)
  status        PurchaseRequestStatus @default(PENDING)
  serviceType   ServiceType?
  notes         String?
  requestedAt   DateTime              @default(now())
  decidedAt     DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String?

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  client   Client? @relation(fields: [clientId], references: [id])
  clientId String?

  requestedBy   User   @relation("PurchaseRequestRequestedBy", fields: [requestedById], references: [id])
  requestedById String

  decidedBy   User?   @relation("PurchaseRequestDecidedBy", fields: [decidedById], references: [id])
  decidedById String?

  expense   Expense? @relation(fields: [expenseId], references: [id])
  expenseId String?  @unique

  quoteItem QuoteItem?

  @@map("purchase_requests")
}

model Quote {
  id          String      @id @default(cuid())
  quoteNumber String      @unique
  status      QuoteStatus @default(DRAFT)
  issueDate   DateTime    @default(now())
  expiryDate  DateTime?
  notes       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  client   Client @relation(fields: [clientId], references: [id])
  clientId String

  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  shipmentId String?

  items   QuoteItem[]
  invoice Invoice?

  @@map("quotes")
}

model QuoteItem {
  id          String       @id @default(cuid())
  description String
  quantity    Decimal      @default(1) @db.Decimal(12, 2)
  unitPrice   Decimal      @db.Decimal(12, 2)
  serviceType ServiceType?

  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId String

  purchaseRequest   PurchaseRequest? @relation(fields: [purchaseRequestId], references: [id])
  purchaseRequestId String?          @unique

  @@map("quote_items")
}

// ---------------------------------------------------------------------------
// Vendor -> Ministry Document Approval & Delivery Clearance
// ---------------------------------------------------------------------------

model Ministry {
  id                    String   @id @default(cuid())
  name                  String
  code                  String   @unique
  description           String?
  active                Boolean  @default(true)
  defaultPosition       Int?
  requiredDocumentTypes String[]
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users         User[]
  chainSteps    MinistryChainStep[]
  approvalSteps ApprovalStep[]

  @@map("ministries")
}

// The authoritative, configurable ordering of ministries per shipment type.
// Ministry.defaultPosition is only a suggested starting point when building
// a new chain in the admin UI.
model MinistryChainStep {
  id           String       @id @default(cuid())
  shipmentType ShipmentType
  position     Int

  ministry   Ministry @relation(fields: [ministryId], references: [id])
  ministryId String

  createdAt DateTime @default(now())

  @@unique([shipmentType, ministryId])
  @@unique([shipmentType, position])
  @@map("ministry_chain_steps")
}

model ClearanceDocument {
  id           String   @id @default(cuid())
  documentType String
  createdAt    DateTime @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  versions ClearanceDocumentVersion[]

  @@map("clearance_documents")
}

// Corrections create new versions; existing versions are never overwritten
// or deleted, preserving what each ministry actually reviewed.
model ClearanceDocumentVersion {
  id        String   @id @default(cuid())
  version   Int
  fileUrl   String
  fileName  String
  createdAt DateTime @default(now())

  document   ClearanceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  uploadedBy   User   @relation(fields: [uploadedById], references: [id])
  uploadedById String

  approvalActions ApprovalAction[]

  @@unique([documentId, version])
  @@map("clearance_document_versions")
}

// One row per (shipment, ministry). Only one step per shipment is ever
// PENDING/IN_REVIEW at a time -- the chain is strictly sequential.
model ApprovalStep {
  id        String             @id @default(cuid())
  position  Int
  status    ApprovalStepStatus @default(PENDING)
  startedAt DateTime?
  decidedAt DateTime?
  createdAt DateTime           @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId String

  ministry   Ministry @relation(fields: [ministryId], references: [id])
  ministryId String

  actions ApprovalAction[]

  @@unique([shipmentId, ministryId])
  @@map("approval_steps")
}

// Append-only audit log. No update/delete action is exposed anywhere in the
// app for this model -- it is the permanent record of who did what, when.
model ApprovalAction {
  id        String             @id @default(cuid())
  action    ApprovalActionType
  note      String
  createdAt DateTime           @default(now())

  step   ApprovalStep @relation(fields: [stepId], references: [id])
  stepId String

  actor   User   @relation(fields: [actorId], references: [id])
  actorId String

  documentVersion   ClearanceDocumentVersion? @relation(fields: [documentVersionId], references: [id])
  documentVersionId String?

  @@map("approval_actions")
}

// Terminal state for this module. `status` and the shipment relation are
// the integration seam for a future delivery/shipping module.
model DeliveryRecord {
  id                String               @id @default(cuid())
  deliveryMode      DeliveryMode
  destinationDetail String
  status            DeliveryRecordStatus @default(PENDING)
  createdAt         DateTime             @default(now())

  shipment   Shipment @relation(fields: [shipmentId], references: [id])
  shipmentId String   @unique

  createdBy   User   @relation(fields: [createdById], references: [id])
  createdById String

  @@map("delivery_records")
}

// Lightweight in-app notification (this platform has no email/queue
// infrastructure yet -- see conversation note on Celery substitution).
model Notification {
  id         String           @id @default(cuid())
  type       NotificationType
  message    String
  shipmentId String?
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user   User   @relation(fields: [userId], references: [id])
  userId String

  @@map("notifications")
}
